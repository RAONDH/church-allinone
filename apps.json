    "win": {
      "exe": [
        "%LOCALAPPDATA%\\Programs\\설교 쇼츠 메이커\\설교 쇼츠 메이커.exe",
        "%LOCALAPPDATA%\\Programs\\sermon-shorts-creator\\설교 쇼츠 메이커.exe"
      ],
      "installer": "{bundle}/apps/설교 쇼츠 메이커 설치.exe"
    }
  },
  {
    "id": "hwptopdf",
