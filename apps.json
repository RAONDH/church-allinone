        "WC_DATA_DIR": "%APPDATA%\\WorshipCaster"
      }
    }
  },
  {
    "id": "worship",
    "name": "찬양곡 선정 (PraiseFlow)",
    "desc": "설교 본문·제목으로 찬송가와 CCM 추천",
    "icon": "🎵",
    "color": "#4f46e5",
    "port": 5173,
    "dir": "~/Documents/praiseflow---예배-찬양-큐레이터",
    "start": "node server.mjs",
    "win": {
      "dir": "{bundle}/apps/PraiseFlow",
      "run": [
        "node",
        "server.mjs"
      ]
    }
  },
  {
    "id": "shorts",
    "name": "설교 쇼츠 제작",
    "desc": "설교 유튜브 링크로 AI가 하이라이트를 찾아 자막 넣은 쇼츠 영상으로",
    "icon": "🎬",
    "color": "#c2410c",
    "port": 3939,
    "dir": "~/Applications/sermon-shorts-maker",
