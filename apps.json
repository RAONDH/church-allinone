    "icon": "📄",
    "color": "#0369a1",
    "port": 5050,
    "dir": "~/Applications/hwp-pdf-to-markdown",
    "start": "[ -x venv/bin/python3 ] || { python3 -m venv venv && venv/bin/pip install -q pyhwp olefile tqdm flask six pypdf; }; ./venv/bin/python3 start-silent.py --no-open",
    "win": {
      "dir": "{bundle}/apps/hwp-pdf-to-markdown",
      "run": [
        "cmd",
        "/c",
        "start-hub.cmd"
      ]
    }
  }
